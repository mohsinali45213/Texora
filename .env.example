# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# MongoDB Atlas (replace with your cluster URI)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/texora?retryWrites=true&w=majority

# Hugging Face Inference API
HF_TOKEN=hf_your_token_here

# Cloudinary (copy from Cloudinary Dashboard > API Keys)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Optional: Next.js Auth URL (required for production deployments)
# NEXTAUTH_URL=https://your-domain.vercel.app
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
